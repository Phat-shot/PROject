# Leer lassen → PGlite als Datei unter DATA_DIR/pglite (kein Postgres nötig)
# DATABASE_URL=postgres://projekttool:projekttool@localhost:5432/projekttool
PORT=3000
DATA_DIR=.data
# Demodaten beim ersten Start anlegen (true/false)
SEED=true
# Mail-Synchronisation des Workers in ms
SYNC_INTERVAL_MS=60000
# Hinter TLS auf true setzen
COOKIE_SECURE=false
