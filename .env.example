# Leer lassen → PGlite als Datei unter DATA_DIR/pglite (kein Postgres nötig)
# DATABASE_URL=postgres://projekttool:projekttool@localhost:5432/projekttool
PORT=3000
DATA_DIR=.data
# Demodaten beim ersten Start anlegen (true/false)
SEED=true
# Mail-Synchronisation des Workers in ms
SYNC_INTERVAL_MS=60000
# Öffentliche Basis-URL für Freigabe-Links (Mails an Externe)
PUBLIC_URL=http://localhost:5173
# Hinter TLS auf true setzen
COOKIE_SECURE=false

# --- Mail-Konten per OAuth2 (Knöpfe erscheinen nur mit gesetzten Werten) ---
# Microsoft 365: App-Registrierung in Entra ID, Redirect-URI = PUBLIC_URL/api/oauth/callback/microsoft
# Berechtigungen (delegiert): offline_access, User.Read, Mail.ReadWrite, Mail.Send, Calendars.ReadWrite (Graph) bzw. IMAP.AccessAsUser.All, SMTP.Send (Modus imap, ohne Kalender)
# OAUTH_MS_CLIENT_ID=
# OAUTH_MS_CLIENT_SECRET=
# OAUTH_MS_TENANT=common
# OAUTH_MS_MODE=graph   # graph (Standard) oder imap
# Google Workspace: OAuth-Client (Web), Redirect-URI = PUBLIC_URL/api/oauth/callback/google, Scopes https://mail.google.com/ und calendar.events
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# --- Single Sign-on per OIDC (Entra ID, Keycloak, Authentik …), Redirect-URI = PUBLIC_URL/api/auth/oidc/callback ---
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=Microsoft Entra ID
# Benutzer werden per E-Mail zugeordnet; true legt unbekannte Benutzer als Mitglied an
# OIDC_AUTO_CREATE=false
# OIDC_SCOPES=openid email profile

# --- KI (Anthropic); alternativ Schlüssel in der Verwaltung je Mandant hinterlegen ---
# ANTHROPIC_API_KEY=

# Schlüssel für gespeicherte Geheimnisse (Mail-Passwörter, OAuth-Tokens, KI-Schlüssel). Leer = Datei DATA_DIR/secret.key wird beim ersten Start erzeugt.
# Mit sichern: ohne Schlüssel sind die gespeicherten Werte unbrauchbar.
# SECRET_KEY=
