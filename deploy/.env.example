# Image aus der GitHub Container Registry (vom Docker-Workflow veröffentlicht)
IMAGE=ghcr.io/phat-shot/project
IMAGE_TAG=latest

# Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Hostname, unter dem Traefik die App ausliefert (PUBLIC_URL wird daraus als https://DOMAIN gebildet)
DOMAIN=projekte.srz.one

# Demodaten beim ersten Start (nur zum Ausprobieren)
SEED=false
SYNC_INTERVAL_MS=60000
