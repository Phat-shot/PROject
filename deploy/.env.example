# Image aus der GitHub Container Registry (vom Docker-Workflow veröffentlicht)
IMAGE=ghcr.io/phat-shot/project
# latest = jeder Push auf main geht (mit Watchtower automatisch) in Betrieb; für kontrollierte Updates eine Version (z. B. 1.2.3) oder einen Commit-SHA setzen
IMAGE_TAG=latest

# Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Hostname, unter dem Traefik die App ausliefert (PUBLIC_URL wird daraus als https://DOMAIN gebildet)
DOMAIN=projekte.srz.one

# Demodaten beim ersten Start (admin@demo.local / demo1234): nur opt-in mit SEED=true und nie in NODE_ENV=production
# (das Image läuft als production, SEED=true wird dort ignoriert; Demodaten nur mit docker-compose.yml im Repo und NODE_ENV=development)
SEED=false
SYNC_INTERVAL_MS=60000

# Vertrauenswürdige Proxys für X-Forwarded-For (Drosselung und Protokoll je Client statt je Traefik); Standard: private Netze.
# Nicht TRUST_PROXY=true setzen, wenn die App auch direkt erreichbar ist: dann kann jeder Client seine Adresse per Header fälschen
# und die Drosselung je Adresse umgehen (die Drosselung je Konto greift weiterhin).
# TRUST_PROXY=loopback,linklocal,uniquelocal

# Interne Dienste, die Benutzer als CalDAV, IMAP/SMTP oder eigenes LLM eintragen dürfen (sonst gesperrt), z. B. nextcloud.lan,10.0.5.0/24
# OUTBOUND_ALLOW_HOSTS=

# Schlüssel für gespeicherte Geheimnisse (Mail-Passwörter, OAuth-Tokens, KI-Schlüssel). Leer = Datei DATA_DIR/secret.key wird beim
# ersten Start erzeugt. Selbst gesetzt: mindestens 32 Byte Zufall, z. B. `openssl rand -hex 32`. Nach dem ersten Start nicht mehr ändern.
# Backup: das Profil „backup“ sichert neben pg_dump auch das Volume appdata (secret.key, Uploads) als projekttool-appdata-<Datum>.tar.gz;
# ohne secret.key bzw. SECRET_KEY sind die gesicherten Geheimnisse unbrauchbar.
# SECRET_KEY=
