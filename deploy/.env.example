# Image aus der GitHub Container Registry (vom Docker-Workflow veröffentlicht)
IMAGE=ghcr.io/phat-shot/project
IMAGE_TAG=latest

# Datenbank
POSTGRES_PASSWORD=bitte-aendern

# Öffentliche Adresse (für Freigabe-Links in Mails); mit Profil proxy: https://DOMAIN
PUBLIC_URL=https://projekte.firma.de
DOMAIN=projekte.firma.de

# Demodaten beim ersten Start (nur zum Ausprobieren)
SEED=false
COOKIE_SECURE=true
SYNC_INTERVAL_MS=60000

# Ohne Proxy: Port nach außen, z. B. 0.0.0.0:3000; mit Proxy auf 127.0.0.1 lassen
APP_PORT=127.0.0.1:3000
